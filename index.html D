<script>
function show(id,btn){
document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
document.getElementById(id).classList.add('active');
if(btn){document.querySelectorAll('.bottom button').forEach(x=>x.classList.remove('active'));btn.classList.add('active')}
window.scrollTo(0,0);
 if(id==="booking")renderBookingSummary();
}

const featuredProfiles=[["C Pro", "71 Parameters", "General", 2999, 1250], ["C Plus Profile with UTSH", "97 Parameters", "General", 3265, 1500], ["Women Basic Profile with UTSH", "73 Parameters", "Women", 2055, 1999], ["USTSH + LH + FSH + PRL", "4 Parameters", "Women", 1670, 1250], ["Aarogyam Camp Profile 3", "78 Parameters", "General", 5280, 1999], ["Aarogyam Purush Profile", "108 Parameters", "Men", 5500, 3000], ["Stree Profile", "111 Parameters", "Women", 5500, 3000]];

function filterProfiles(){
 const q=(document.getElementById("profileSearch")?.value||"").toLowerCase().trim();
 const box=document.getElementById("featuredProfiles"); if(!box)return;
 const matches=featuredProfiles.map((p,i)=>[p,i]).filter(([p])=>!q||p[0].toLowerCase().includes(q)||p[2].toLowerCase().includes(q));
 box.innerHTML=matches.map(([p,i])=>`<div class="card profileCard">
  <div class="profileTop"><span class="profileBadge">${p[2]}</span><span class="profileParams">${p[1]}</span></div>
  <h3>${p[0]}</h3><div class="labNote">🧪 Diagnostic Lab Network</div>
  <div class="mrp">MRP <s>₹${p[3].toLocaleString("en-IN")}</s></div>
  <div class="offer">₹${p[4].toLocaleString("en-IN")} <span>OFFER PRICE</span></div>
  <div class="profile-actions">
   <button class="btn outline" onclick="viewProfile(${i})">View Included Tests</button>
   <button class="btn primary" onclick="selectProfile(${i})">${selectedProfiles.includes(i)?"Added ✓":"Add Profile"}</button>
  </div>
 </div>`).join("") || `<div class="card">No matching profile found.</div>`;
}
