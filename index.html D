 const name=document.getElementById("bookingName")?.value.trim();
 const mobile=(document.getElementById("bookingMobile")?.value||"").replace(/\D/g,"");
 const area=document.getElementById("bookingArea")?.value.trim();
 const pincode=document.getElementById("bookingPincode")?.value.trim();
 const date=document.getElementById("bookingDate")?.value||"";
 const time=document.getElementById("bookingTime")?.value||"";
 const note=document.getElementById("bookingNote")?.value.trim()||"";
 if(!name||mobile.length!==10||!area){msg.innerHTML='<div class="notice">Please enter Name, valid 10-digit Mobile and Area / City.</div>';return;}
 if(!firebaseReady){msg.innerHTML='<div class="notice">Firebase is not connected. Check Firebase project configuration and authorized domain.</div>';return;}
 if(!auth.currentUser){msg.innerHTML='<div class="notice">Please login with OTP first so the booking can be securely linked to your account.</div>';setTimeout(()=>show("login"),400);return;}
 const tests=selectedCatalog.map(i=>testCatalog[i]?.[0]).filter(Boolean),profiles=selectedProfiles.map(i=>featuredProfiles[i]?.[0]).filter(Boolean);
 btn.disabled=true;btn.textContent="Submitting…";
 const booking={patientName:name,mobile,area,pincode,preferredDate:date,preferredTime:time,note,tests,profiles,status:"Pending",createdAt:firebase.firestore.FieldValue.serverTimestamp(),userId:auth.currentUser.uid};
 try{
   const ref=await db.collection("bookings").add(booking);
   msg.innerHTML=`<div class="success">Booking request submitted successfully. ID: <b>${ref.id.slice(0,8).toUpperCase()}</b>. Final availability will be confirmed.</div>`;
   selectedCatalog=[];selectedProfiles=[];renderBookingSummary();filterTests();filterProfiles();loadMyBookings();toast("Booking request submitted");
 }catch(err){console.error(err);msg.innerHTML='<div class="notice">Booking save failed. Check Firestore Security Rules and Firebase connection.</div>';}
 finally{btn.disabled=false;btn.textContent="🔔 Submit Booking Request";}
}

async function loadMyBookings(){
 const box=document.querySelector("#mybookings .section");if(!box)return;
 if(!firebaseReady||!auth.currentUser){box.innerHTML="<h2>📋 My Bookings</h2><div class='card'>Login to see your secure booking history.</div>";return;}
 try{
  const snap=await db.collection("bookings").where("userId","==",auth.currentUser.uid).limit(20).get();
  const cards=[];snap.forEach(doc=>{const b=doc.data(),items=[...(b.profiles||[]),...(b.tests||[])];cards.push(`<div class="card"><div style="display:flex;justify-content:space-between;gap:8px"><b>Booking #${doc.id.slice(0,8).toUpperCase()}</b><span style="background:#fff3cd;color:#856404;padding:5px 8px;border-radius:8px;font-size:11px;font-weight:800">${b.status||"Pending"}</span></div><p>${items.join(" + ")||"Custom Request"}</p><small>${b.area||""} · ${b.preferredDate||"Date to be confirmed"} · ${b.preferredTime||""}</small></div>`);});
  box.innerHTML="<h2>📋 My Bookings</h2>"+(cards.join("")||"<div class='card'>No bookings yet.</div>");
 }catch(err){console.error(err);box.innerHTML="<h2>📋 My Bookings</h2><div class='notice'>Could not load bookings. Check Firestore Security Rules.</div>";}
}

if(firebaseReady && !firebaseConfig.apiKey.startsWith("PASTE_")){
  auth.onAuthStateChanged(user => {
    if(user) loadMyBookings();
  });
}

</script>
