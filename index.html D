 const matches=testCatalog.map((t,i)=>[t,i]).filter(([t])=>(cat==="All Categories"||t[1]===cat)&&t[0].toLowerCase().includes(q));
 box.innerHTML=matches.map(([t,i])=>{
   const checked=selectedCatalog.includes(i);
   return `<div class="card test"><input type="checkbox" ${checked?"checked":""} onchange="toggleCatalog(${i})"><span class="name">${t[0]}<br><small style="color:#78909b">${t[1]}</small></span><span class="price">Check</span></div>`;
 }).join("") || `<div class="card">Test not listed. Use <b>Request Any Test / Custom Profile</b> to ask us to check connected labs.</div>`;
